# 依赖（克隆后 npm install 可重建）
node_modules/
jspm_packages/

# TypeScript 增量编译缓存
*.tsbuildinfo

# 注意：dist/ 是编译产物，但必须提交——
# Cocos Creator 加载的是 dist/main.js，不提交的话克隆者必须先
# npm install && npm run build 才能启用扩展。

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 运行时临时文件
temp/
local/
.cache/
*.tmp

# 打包产物（npm run pack:zip 生成，用于上传 GitHub Release）
release/
